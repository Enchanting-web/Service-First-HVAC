{
  "name": "service-first-hvac",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  // Workers Builds: `npm run build` then `npx wrangler versions upload`.
  // npx the adapter here so Appwrite's `next build` does not install Wrangler.
  "build": {
    "command": "npx --yes @opennextjs/cloudflare@1.20.4 build",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "service-first-hvac",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
}
