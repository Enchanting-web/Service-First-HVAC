<main id="main-content" class="content"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb">
  {{#each path_steps}}
    {{#if current_page}}
      <span aria-current="page">{{name}}</span>
    {{else}}
      <a href="{{url}}">{{name}}</a><span aria-hidden="true"> / </span>
    {{/if}}
  {{/each}}
</nav><h1 class="page-title">{{topic.name}}</h1><section class="panel">{{topic.description}}{{#each posts}}<div class="list"><a href="{{url}}">{{title}}</a><p>{{excerpt details}}</p></div>{{/each}}</section></div></main>
