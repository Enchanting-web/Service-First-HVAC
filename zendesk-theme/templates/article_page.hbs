<main id="main-content" class="content"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb">
  {{#each path_steps}}
    {{#if current_page}}
      <span aria-current="page">{{name}}</span>
    {{else}}
      <a href="{{url}}">{{name}}</a><span aria-hidden="true"> / </span>
    {{/if}}
  {{/each}}
</nav><h1 class="page-title">{{article.title}}</h1><div class="article-meta"><span>Updated {{article.updated_at}}</span>{{#if article.author.name}}<span>By {{article.author.name}}</span>{{/if}}</div><div class="two-col"><article class="article"><div class="article-body">{{article.body}}</div><div class="notice"><strong>Need help with this issue?</strong> If you smell gas, see smoke, or suspect an electrical hazard, leave the area and contact emergency services or your utility first. For HVAC service, call <a href="tel:+15132687290">(513) 268-7290</a>.</div><div class="article-feedback">{{article.vote 'up' class='vote-up' selected_class='vote-selected'}} {{article.vote 'down' class='vote-down' selected_class='vote-selected'}} {{article.vote 'label' class='vote-label'}}</div>{{#if comments}}<section aria-label="Article comments"><h2>Questions and comments</h2>{{#each comments}}<div class="list"><strong>{{author.name}}</strong><p>{{body}}</p></div>{{/each}}</section>{{/if}}</article><aside class="sidebar panel"><h2>More help</h2><p>Search for a related question or talk with our local team.</p><a href="{{page_path 'search'}}">Search help articles</a><a href="https://hvacservicefirst.com/contact">Request service</a><a href="tel:+15132687290">Call (513) 268-7290</a></aside></div></div></main>
