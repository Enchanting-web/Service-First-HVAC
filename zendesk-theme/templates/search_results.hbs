<main id="main-content" class="content"><div class="wrap"><h1 class="page-title">Search help articles</h1><div class="search-shell" data-help-search>{{search submit=true instant=true}}</div>{{#if results}}<p class="section-intro">Answers related to your search</p><section class="panel"><ul class="list">{{#each results}}<li><a href="{{url}}">{{title}}</a><p>{{text}}</p><span class="search-result-meta">{{type}}</span></li>{{/each}}</ul>{{pagination}}</section>{{else}}<div class="panel"><p>No articles matched this search. Try different words, or contact us for help.</p><a class="button" href="https://hvacservicefirst.com/contact">Contact Service First</a></div>{{/if}}</div></main>
