<main id="main-content" class="content"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb">
  {{#each path_steps}}
    {{#if current_page}}
      <span aria-current="page">{{name}}</span>
    {{else}}
      <a href="{{url}}">{{name}}</a><span aria-hidden="true"> / </span>
    {{/if}}
  {{/each}}
</nav><h1 class="page-title">Community discussions</h1><section class="panel"><ul class="list">{{#each posts}}<li><a href="{{url}}">{{title}}</a><p>{{excerpt details}}</p><span class="meta">{{comment_count}} comments</span></li>{{/each}}</ul>{{pagination}}</section></div></main>
