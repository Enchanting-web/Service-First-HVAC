<main id="main-content" class="content"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb">
  {{#each path_steps}}
    {{#if current_page}}
      <span aria-current="page">{{name}}</span>
    {{else}}
      <a href="{{url}}">{{name}}</a><span aria-hidden="true"> / </span>
    {{/if}}
  {{/each}}
</nav><h1 class="page-title">Community topics</h1><section class="card-grid">{{#each topics}}<article class="card"><h2><a href="{{url}}">{{name}}</a></h2><p>{{description}}</p></article>{{/each}}</section>{{pagination}}</div></main>
