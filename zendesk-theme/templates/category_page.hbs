<main id="main-content" class="content"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb">
  {{#each path_steps}}
    {{#if current_page}}
      <span aria-current="page">{{name}}</span>
    {{else}}
      <a href="{{url}}">{{name}}</a><span aria-hidden="true"> / </span>
    {{/if}}
  {{/each}}
</nav><h1 class="page-title">{{category.name}}</h1><p class="section-intro">{{category.description}}</p><div class="card-grid">{{#each sections}}<article class="card"><h2><a href="{{url}}">{{name}}</a></h2><p>{{excerpt description}}</p></article>{{/each}}</div></div></main>
