<main id="main-content" class="content">
  <div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb">
  {{#each path_steps}}
    {{#if current_page}}
      <span aria-current="page">{{name}}</span>
    {{else}}
      <a href="{{url}}">{{name}}</a><span aria-hidden="true"> / </span>
    {{/if}}
  {{/each}}
</nav>
    <h1 class="page-title">My contributions</h1>
    <section class="panel">
      <nav aria-label="Contribution type"><ul class="list">
        {{#each filters}}<li><a href="{{url}}">{{name}}</a></li>{{/each}}
      </ul></nav>
      <ul class="list">
        {{#each contributions}}
          <li><a href="{{url}}">{{title}}</a><p>{{type}}</p></li>
        {{else}}
          <li>You have no contributions in this category.</li>
        {{/each}}
      </ul>
      {{pagination}}
    </section>
  </div>
</main>
